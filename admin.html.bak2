<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<meta name="theme-color" content="#05070b">
<title>VORTEX — مركز التحكم</title>
<script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
<style>
:root{--bg:#05070b;--bg2:#081019;--panel:#0a0f14;--panel2:#0e151c;--line:#1b2932;--line2:#263945;--text:#f5f9fb;--muted:#8d9ba4;--cyan:#13abd2;--ice:#76e5fd;--blue:#075bff;--green:#48d59b;--red:#ff6376;--amber:#ffc45c;--max:1240px;--shadow:0 24px 80px #0009}
*{box-sizing:border-box}html{scroll-behavior:smooth}body{margin:0;background:radial-gradient(circle at 80% -10%,#103747 0,transparent 30%),radial-gradient(circle at 10% 15%,#0b2030 0,transparent 25%),var(--bg);color:var(--text);font-family:system-ui,-apple-system,"Segoe UI",Tahoma,Arial,sans-serif;overflow-x:hidden}body:before{content:"";position:fixed;inset:0;pointer-events:none;opacity:.055;background:linear-gradient(125deg,transparent 0 34%,#fff 34.15% 34.3%,transparent 34.5% 100%)}
a{color:inherit;text-decoration:none}button,input,textarea,select{font:inherit}button{cursor:pointer}.hidden{display:none!important}.container{width:min(calc(100% - 34px),var(--max));margin:auto}
.topbar{position:sticky;top:0;z-index:100;background:#05070be8;border-bottom:1px solid var(--line);backdrop-filter:blur(20px)}.topbar-inner{min-height:74px;display:flex;align-items:center;justify-content:space-between;gap:16px}.brand{display:flex;align-items:center;gap:12px;font-weight:950}.brand-mark{width:42px;height:42px;border:1px solid #2a3a43;border-radius:13px;background:#05080b;display:grid;place-items:center;overflow:hidden}.brand-mark img{width:78%;height:78%;object-fit:contain}.brand-name{font-size:18px;letter-spacing:.12em}.brand-sub{display:block;color:#74828a;font-size:9px;letter-spacing:.28em;margin-top:3px}.top-actions{display:flex;align-items:center;gap:9px}.top-actions a,.top-actions button{border:1px solid var(--line2);background:#0b1116;color:#dce7eb;padding:10px 13px;border-radius:11px}.top-actions a:hover,.top-actions button:hover{border-color:#13abd277;color:var(--ice)}
.hero{padding:42px 0 25px}.hero-grid{display:grid;grid-template-columns:1.4fr .6fr;gap:18px;align-items:stretch}.hero-card,.card{background:linear-gradient(145deg,#0c1218e8,#080d12e8);border:1px solid var(--line);border-radius:22px;box-shadow:var(--shadow)}.hero-card{position:relative;overflow:hidden;padding:30px}.hero-card:after{content:"";position:absolute;width:260px;height:260px;border-radius:50%;left:-100px;top:-110px;background:radial-gradient(circle,#13abd222,transparent 68%)}.eyebrow,.kicker{color:var(--ice);font-weight:900;letter-spacing:.22em;font-size:10px;text-transform:uppercase}.hero h1{font-size:clamp(34px,5vw,62px);line-height:1;margin:12px 0}.hero p{color:var(--muted);line-height:1.9;max-width:700px;margin:0}.hero-side{padding:22px;display:flex;flex-direction:column;justify-content:space-between}.status-dot{display:inline-flex;align-items:center;gap:8px;color:#bfeef9;font-size:13px}.status-dot i{width:8px;height:8px;border-radius:50%;background:var(--green);box-shadow:0 0 15px #48d59b88}.hero-mini{font-size:12px;color:var(--muted);line-height:1.8}.hero-mini b{display:block;color:#eaf4f7;font-size:22px;margin-top:3px}
.layout{display:grid;grid-template-columns:210px minmax(0,1fr);gap:18px;padding:15px 0 60px}.sidebar{position:sticky;top:93px;align-self:start;padding:10px;background:#080d12cc;border:1px solid var(--line);border-radius:20px;backdrop-filter:blur(15px)}.tab-btn{width:100%;border:1px solid transparent;background:transparent;color:#9ba9b0;text-align:right;padding:13px 14px;border-radius:12px;margin:2px 0;font-weight:800;transition:.2s}.tab-btn:hover{background:#0e171e;color:#dff7fc}.tab-btn.active{background:linear-gradient(100deg,#13abd21b,#13abd207);border-color:#13abd255;color:var(--ice);box-shadow:inset -3px 0 0 var(--cyan)}.content{min-width:0}.tab{display:none;animation:fadeUp .28s ease}.tab.active{display:block}@keyframes fadeUp{from{opacity:0;transform:translateY(8px)}to{opacity:1;transform:none}}
.grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:14px}.full{grid-column:1/-1}.card{padding:22px;margin-bottom:15px}.card-head{display:flex;align-items:flex-start;justify-content:space-between;gap:15px;margin-bottom:18px}.card h2{font-size:21px;margin:0 0 5px}.card-head p,.hint{margin:0;color:var(--muted);line-height:1.7;font-size:13px}.field{display:block;color:#cbd7dc;font-size:13px;font-weight:800}.field input,.field textarea,.field select{width:100%;margin-top:7px;padding:12px 13px;border-radius:12px;border:1px solid var(--line2);background:#070b0f;color:#fff;outline:none}.field input:focus,.field textarea:focus,.field select:focus{border-color:#13abd277;box-shadow:0 0 0 3px #13abd214}.field textarea{min-height:125px;resize:vertical}.row{display:flex;align-items:center;gap:9px;flex-wrap:wrap}.btn{border:1px solid var(--line2);background:#0d141a;color:#dce7eb;padding:10px 14px;border-radius:11px;font-weight:850}.btn:hover{border-color:#13abd277;color:var(--ice)}.btn.primary{background:var(--cyan);border-color:var(--cyan);color:#031015;box-shadow:0 8px 28px #13abd233}.btn.primary:hover{background:var(--ice);color:#021017}.btn.danger{background:#3a1118;border-color:#68212d;color:#ffb0ba}.btn.danger:hover{background:#5a1823}.btn.green{background:#103c2d;border-color:#1d6b4e;color:#9df2cc}.btn.amber{background:#3a2b0f;border-color:#60491a;color:#ffd982}.btn:disabled{opacity:.45;cursor:not-allowed}
.msg{margin-top:12px;padding:11px 13px;border-radius:11px;background:#070b0f;border:1px solid var(--line);color:#bfe7ff;white-space:pre-wrap;min-height:0}.msg:empty{display:none}.progress{height:9px;background:#10171c;border-radius:99px;overflow:hidden;margin-top:12px}.progress i{display:block;height:100%;width:0;background:linear-gradient(90deg,var(--blue),var(--cyan),var(--ice));transition:.2s}
.stats{display:grid;grid-template-columns:repeat(4,1fr);gap:11px;margin-bottom:15px}.stat{padding:18px;border:1px solid var(--line);border-radius:17px;background:linear-gradient(145deg,#0d1419,#080d11)}.stat small{color:#7e8d95}.stat strong{display:block;font-size:29px;margin-top:7px}.stat.accent strong{color:var(--ice)}.stat.ok strong{color:var(--green)}
.quick-grid{display:grid;grid-template-columns:repeat(3,1fr);gap:11px}.quick{border:1px solid var(--line);background:#090f14;padding:17px;border-radius:15px;cursor:pointer;text-align:right;color:#dbe7eb}.quick:hover{border-color:#13abd255;transform:translateY(-2px);transition:.2s}.quick b{display:block;margin-bottom:5px}.quick span{color:var(--muted);font-size:12px}
.chapter-list{display:grid;gap:9px}.chapter-item{display:grid;grid-template-columns:62px minmax(0,1fr) auto;gap:14px;align-items:center;padding:12px;border:1px solid var(--line);background:#090e13;border-radius:15px;transition:.2s}.chapter-item:hover{border-color:#13abd244;background:#0b1319}.chapter-cover{width:62px;height:82px;border-radius:9px;object-fit:cover;background:#0d151a;border:1px solid var(--line)}.chapter-num{font-size:20px;font-weight:950;color:#eef8fb}.chapter-meta{color:var(--muted);font-size:12px;margin-top:4px}.badge{display:inline-flex;align-items:center;padding:5px 9px;border-radius:999px;background:#0d2933;color:#9de8fb;border:1px solid #1b4b5b;font-size:11px;font-weight:800}.searchbar{display:flex;gap:9px;margin-bottom:12px}.searchbar input{flex:1;background:#070b0f;color:#fff;border:1px solid var(--line2);border-radius:12px;padding:12px 13px;outline:none}
.dropzone{border:1px dashed #31505d;border-radius:17px;padding:25px;text-align:center;background:radial-gradient(circle at 50% 0,#13abd20d,transparent 60%),#080e13;transition:.2s}.dropzone.drag{border-color:var(--cyan);background:#0b1b22}.dropzone b{display:block;font-size:15px}.dropzone span{display:block;color:var(--muted);font-size:12px;margin-top:6px}.file-list{display:grid;gap:7px;margin-top:12px;max-height:330px;overflow:auto}.file-item{display:flex;align-items:center;gap:10px;padding:8px;border:1px solid var(--line);border-radius:11px;background:#080d12}.file-item img{width:40px;height:55px;object-fit:cover;border-radius:6px}.file-item .file-info{min-width:0;flex:1}.file-item b{display:block;white-space:nowrap;overflow:hidden;text-overflow:ellipsis;font-size:12px}.file-item small{color:var(--muted)}
.manga-preview{display:grid;grid-template-columns:180px minmax(0,1fr);gap:20px;align-items:start}.cover-box{width:180px;aspect-ratio:2/3;border-radius:16px;overflow:hidden;background:#080d11;border:1px solid var(--line);box-shadow:0 20px 55px #0009}.cover-box img{width:100%;height:100%;object-fit:cover}.meta-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:10px;margin-top:14px}.mini{padding:13px;border:1px solid var(--line);background:#080d12;border-radius:13px}.mini small{display:block;color:#75858e;margin-bottom:4px}.mini b{font-size:13px}
.page-tools{display:flex;gap:9px;align-items:center;flex-wrap:wrap;margin-bottom:12px}.page-grid{display:grid;grid-template-columns:repeat(5,1fr);gap:10px}.page-card{position:relative;border:1px solid var(--line);border-radius:13px;overflow:hidden;background:#070b0f}.page-card img{display:block;width:100%;aspect-ratio:2/3;object-fit:cover}.page-card .page-foot{padding:8px;display:flex;align-items:center;justify-content:space-between;gap:6px}.page-card small{color:#93a2aa}.page-card button{padding:6px 8px;font-size:11px}
.empty{padding:45px 20px;text-align:center;border:1px dashed #2b3b43;border-radius:16px;color:var(--muted)}.dangerText{color:#ff9da8}.successText{color:#9df2cc}.muted{color:var(--muted)}
.toast{position:fixed;left:20px;bottom:20px;z-index:200;max-width:min(420px,calc(100% - 40px));padding:13px 15px;border-radius:13px;background:#0b1217ee;border:1px solid #2a414b;box-shadow:0 18px 60px #000b;transform:translateY(20px);opacity:0;pointer-events:none;transition:.25s}.toast.show{transform:none;opacity:1}.toast.ok{border-color:#1f6d51}.toast.err{border-color:#71303b}.login-wrap{min-height:calc(100vh - 74px);display:grid;place-items:center;padding:30px}.login-card{width:min(520px,100%);padding:30px}.login-logo{width:72px;height:72px;border-radius:22px;border:1px solid #29404a;background:#060a0d;display:grid;place-items:center;margin-bottom:20px}.login-logo img{width:72%}
@media(max-width:1000px){.layout{grid-template-columns:1fr}.sidebar{position:static;display:grid;grid-template-columns:repeat(5,1fr);gap:4px}.tab-btn{text-align:center}.hero-grid{grid-template-columns:1fr}.stats{grid-template-columns:repeat(2,1fr)}.page-grid{grid-template-columns:repeat(4,1fr)}}
@media(max-width:700px){.container{width:min(calc(100% - 22px),var(--max))}.topbar-inner{min-height:64px}.brand-name{font-size:15px}.brand-sub{font-size:8px}.top-actions a:not(:last-child){display:none}.hero{padding-top:22px}.hero-card{padding:23px}.sidebar{grid-template-columns:repeat(2,1fr)}.grid,.manga-preview,.meta-grid{grid-template-columns:1fr}.full{grid-column:auto}.stats{grid-template-columns:repeat(2,1fr)}.quick-grid{grid-template-columns:1fr}.chapter-item{grid-template-columns:54px minmax(0,1fr)}.chapter-item>.row{grid-column:2}.chapter-cover{width:54px;height:72px}.page-grid{grid-template-columns:repeat(3,1fr)}.cover-box{width:min(220px,65vw);margin:auto}}
@media(max-width:430px){.stats{grid-template-columns:1fr 1fr}.page-grid{grid-template-columns:repeat(2,1fr)}.top-actions button{display:none}.hero h1{font-size:36px}}
</style>
</head>
<body>
<header class="topbar"><div class="topbar-inner container"><a class="brand" href="index.html"><span class="brand-mark"><img src="assets/vortex-mark-white.png" alt="Vortex"></span><span><span class="brand-name">VORTEX</span><span class="brand-sub">CONTROL CENTER</span></span></a><div class="top-actions"><a href="index.html">عرض الموقع</a><button id="logout" class="hidden">تسجيل الخروج</button></div></div></header>

<section id="login" class="login-wrap"><div class="login-card card"><div class="login-logo"><img src="assets/vortex-mark-cyan.png" alt="Vortex" style="width:72%"></div><div class="kicker">VORTEX CONTROL CENTER</div><h1 style="margin:8px 0 8px">مركز التحكم</h1><p class="hint">إدارة المانجا والفصول والصفحات من واجهة واحدة، بنفس الهوية البصرية للموقع.</p><div style="height:18px"></div><div class="grid"><label class="field">البريد الإلكتروني<input id="email" type="email" autocomplete="username"></label><label class="field">كلمة المرور<input id="password" type="password" autocomplete="current-password"></label></div><button id="loginBtn" class="btn primary" style="width:100%;margin-top:13px">دخول إلى لوحة الإدارة</button><div id="loginMsg" class="msg"></div></div></section>

<main id="app" class="hidden">
<section class="hero"><div class="container hero-grid"><div class="hero-card"><div class="eyebrow">VORTEX / ADMIN</div><h1>مركز التحكم.</h1><p>كل ما تحتاجه لإدارة العمل المنشور: معلومات المانجا، الفصول، صور الصفحات، والمعاينة قبل النشر. الواجهة مصممة لتبقى عملية حتى من الهاتف.</p></div><div class="hero-card hero-side"><div><span class="status-dot"><i></i> اتصال Supabase نشط</span></div><div class="hero-mini">آخر مزامنة تقريبية<strong id="lastSync">—</strong></div></div></div></section>
<div class="container layout">
<aside class="sidebar"><button class="tab-btn active" data-tab="dashboard">لوحة التحكم</button><button class="tab-btn" data-tab="chaptersTab">الفصول</button><button class="tab-btn" data-tab="mangaTab">بيانات المانجا</button><button class="tab-btn" data-tab="pagesTab">الصفحات</button><button class="tab-btn" data-tab="publishTab">نشر فصل</button></aside>
<section class="content">
<div id="dashboard" class="tab active">
<div class="stats"><div class="stat accent"><small>إجمالي الفصول</small><strong id="statChapters">—</strong></div><div class="stat"><small>إجمالي الصفحات</small><strong id="statPages">—</strong></div><div class="stat ok"><small>آخر فصل</small><strong id="statLatest">—</strong></div><div class="stat"><small>حالة النظام</small><strong id="statStatus" style="font-size:18px">متصل</strong></div></div>
<div class="card"><div class="card-head"><div><h2>الوصول السريع</h2><p>انتقل مباشرة إلى المهمة التي تريد تنفيذها.</p></div></div><div class="quick-grid"><button class="quick" data-go="publishTab"><b>＋ نشر فصل جديد</b><span>رفع الصور وترتيبها وحفظ بيانات الفصل.</span></button><button class="quick" data-go="mangaTab"><b>✎ تعديل معلومات المانجا</b><span>العنوان، الوصف، التصنيفات، الغلاف والبيانات الأساسية.</span></button><button class="quick" data-go="chaptersTab"><b>▤ إدارة الفصول</b><span>البحث، التعديل، الحذف ومعاينة أغلفة الفصول.</span></button></div></div>
<div class="card"><div class="card-head"><div><h2>آخر الفصول</h2><p>معاينة سريعة لما هو منشور حاليًا.</p></div><button class="btn" id="refreshBtn">تحديث</button></div><div id="recentChapters" class="chapter-list"></div></div>
</div>

<div id="chaptersTab" class="tab"><div class="card"><div class="card-head"><div><div class="kicker">LIBRARY</div><h2>إدارة الفصول</h2><p>كل فصل يعرض صورته الأولى تلقائيًا كغلاف معاينة.</p></div><button class="btn" id="refreshChapters">تحديث</button></div><div class="searchbar"><input id="chapterSearch" placeholder="ابحث برقم الفصل أو العنوان..."><select id="chapterSort" style="width:auto;background:#070b0f;color:#fff;border:1px solid var(--line2);border-radius:12px;padding:11px"><option value="desc">الأحدث أولًا</option><option value="asc">الأقدم أولًا</option></select></div><div id="chaptersList" class="chapter-list"></div></div></div>

<div id="mangaTab" class="tab"><div class="card"><div class="card-head"><div><div class="kicker">MANGA PROFILE</div><h2>بيانات المانجا</h2><p>هذه المعلومات تظهر في صفحة العمل الرئيسية.</p></div></div><div class="manga-preview"><div class="cover-box"><img id="coverPreview" src="assets/boruto-cover.jpg" alt="غلاف المانجا"></div><div><div class="grid"><label class="field">العنوان العربي<input id="mTitle"></label><label class="field">العنوان الإنجليزي<input id="mEnglish"></label><label class="field">العنوان الياباني<input id="mJapanese"></label><label class="field">الحالة<input id="mStatus"></label><label class="field">الكاتب<input id="mAuthor"></label><label class="field">الرسام<input id="mArtist"></label><label class="field full">رابط الغلاف<input id="mCover" placeholder="assets/boruto-cover.jpg أو رابط صورة مباشر"></label><label class="field full">التصنيفات<input id="mGenres"></label><label class="field full">الوصف<textarea id="mDescription"></textarea></label></div><div class="row" style="margin-top:14px"><button id="saveManga" class="btn primary">حفظ بيانات المانجا</button></div><div id="mangaMsg" class="msg"></div></div></div></div></div>

<div id="publishTab" class="tab"><div class="card"><div class="card-head"><div><div class="kicker">PUBLISH</div><h2>نشر أو تحديث فصل</h2><p>يمكنك إنشاء فصل جديد، تحديث عنوانه وتاريخه، أو إضافة صفحات جديدة إلى فصل موجود.</p></div></div><div class="grid"><label class="field">رقم الفصل<input id="num" type="number" min="1" step="1" value="1"></label><label class="field">عنوان الفصل<input id="title" value="الفصل 1"></label><label class="field">تاريخ النشر<input id="date" type="date"></label><label class="field">طريقة الرفع<select id="uploadMode"><option value="append">إضافة الصفحات إلى الموجود</option><option value="replace">استبدال صفحات الفصل بالكامل</option></select></label></div><div style="height:15px"></div><div id="dropzone" class="dropzone"><b>اسحب صور الصفحات إلى هنا</b><span>أو اختر الصور من الجهاز — JPG / PNG / WEBP</span><input id="files" type="file" accept="image/jpeg,image/png,image/webp" multiple style="display:none"></div><div id="fileList" class="file-list"></div><div class="row" style="margin-top:13px"><button id="chooseFiles" class="btn">اختيار الصور</button><button id="clearFiles" class="btn">مسح الاختيار</button><button id="saveChapter" class="btn primary">حفظ الفصل ورفع الصفحات</button></div><div class="progress"><i id="bar"></i></div><div id="uploadMsg" class="msg"></div></div></div>

<div id="pagesTab" class="tab"><div class="card"><div class="card-head"><div><div class="kicker">PAGE MANAGER</div><h2>إدارة صفحات الفصل</h2><p>معاينة الصفحات وحذف الصفحات الفردية عند الحاجة.</p></div></div><div class="page-tools"><select id="pageChapter" style="flex:1;min-width:220px;background:#070b0f;color:#fff;border:1px solid var(--line2);border-radius:12px;padding:11px"></select><button id="refreshPages" class="btn">تحديث</button></div><div id="pageList" class="page-grid"></div><div id="pageMsg" class="msg"></div></div></div>
</section></div></main>
<div id="toast" class="toast"></div>
<script>
const SUPABASE_URL='https://smgvqaunvvkbwkkgmccx.supabase.co';
const SUPABASE_KEY='sb_publishable_S7Wd8d7OGc1m7bsHY4Awnw_ToSxY_j6';
const db=supabase.createClient(SUPABASE_URL,SUPABASE_KEY);
const $=id=>document.getElementById(id); const say=(id,t)=>$(id).textContent=t||'';
let mangaId=null, chaptersCache=[], selectedFiles=[];
const fallbackCover='assets/boruto-cover.jpg';
function esc(s){return String(s??'').replace(/[&<>"']/g,m=>({'&':'&amp;','<':'&lt;','>':'&gt;','"':'&quot;',"'":'&#039;'}[m]))}
function publicUrl(path){if(!path)return '';return `${SUPABASE_URL}/storage/v1/object/public/manga-pages/${String(path).split('/').filter(Boolean).map(encodeURIComponent).join('/')}`}
function toast(text,type='ok'){const t=$('toast');t.textContent=text;t.className='toast show '+(type==='err'?'err':'ok');clearTimeout(window.__toast);window.__toast=setTimeout(()=>t.className='toast',3200)}
function setTab(id){document.querySelectorAll('.tab-btn').forEach(x=>x.classList.toggle('active',x.dataset.tab===id));document.querySelectorAll('.tab').forEach(x=>x.classList.toggle('active',x.id===id));window.scrollTo({top:0,behavior:'smooth'})}
document.querySelectorAll('.tab-btn').forEach(b=>b.onclick=()=>setTab(b.dataset.tab));document.querySelectorAll('[data-go]').forEach(b=>b.onclick=()=>setTab(b.dataset.go));
async function session(){const r=await db.auth.getSession();if(r.error)throw r.error;return r.data.session}
function showLogin(msg=''){ $('login').classList.remove('hidden');$('app').classList.add('hidden');$('logout').classList.add('hidden');say('loginMsg',msg)}
function showApp(){ $('login').classList.add('hidden');$('app').classList.remove('hidden');$('logout').classList.remove('hidden');refreshAll() }
$('loginBtn').onclick=async()=>{say('loginMsg','جاري تسجيل الدخول...');const r=await db.auth.signInWithPassword({email:$('email').value.trim(),password:$('password').value});if(r.error)return say('loginMsg','فشل تسجيل الدخول: '+r.error.message);showApp()};
$('logout').onclick=async()=>{await db.auth.signOut();showLogin()};db.auth.onAuthStateChange((_e,s)=>{if(s&&$('app').classList.contains('hidden'))showApp()});
function numericName(n){const m=n.match(/(\d+)/g);return m?Number(m[m.length-1]):999999999}
async function getManga(){const r=await db.from('manga').select('*').limit(1).maybeSingle();if(r.error)throw r.error;if(r.data){mangaId=r.data.id;$('mTitle').value=r.data.title||'';$('mEnglish').value=r.data.english||'';$('mJapanese').value=r.data.japanese||'';$('mStatus').value=r.data.status||'';$('mAuthor').value=r.data.author||'';$('mArtist').value=r.data.artist||'';$('mCover').value=r.data.cover_url||fallbackCover;$('mGenres').value=Array.isArray(r.data.genres)?r.data.genres.join('، '):(r.data.genres||'');$('mDescription').value=r.data.description||'';$('coverPreview').src=r.data.cover_url||fallbackCover}return r.data}
function firstPage(c){return (c.pages||[]).slice().sort((a,b)=>Number(a.page_number)-Number(b.page_number))[0]}
function chapterCover(c){const p=firstPage(c);return p?.storage_path?publicUrl(p.storage_path):fallbackCover}
async function refreshAll(){try{$('statStatus').textContent='متصل';await getManga();const r=await db.from('chapters').select('id,manga_id,number,title,published_at,pages(id,page_number,storage_path)').order('number',{ascending:false});if(r.error)throw r.error;chaptersCache=r.data||[];$('statChapters').textContent=chaptersCache.length;$('statPages').textContent=chaptersCache.reduce((n,c)=>n+(c.pages?.length||0),0);$('statLatest').textContent=chaptersCache[0]?String(chaptersCache[0].number):'—';$('lastSync').textContent=new Date().toLocaleTimeString('ar-IQ',{hour:'2-digit',minute:'2-digit'});renderChapters();renderRecent();fillPageChapter();loadPageList()}catch(e){$('statStatus').textContent='خطأ';toast('تعذر مزامنة البيانات: '+e.message,'err');console.error(e)}}
function chapterMarkup(c,compact=false){const cover=chapterCover(c);return `<div class="chapter-item"><img class="chapter-cover" src="${esc(cover)}" alt=""><div><div class="row"><span class="chapter-num">الفصل ${esc(c.number)}</span><span class="badge">${c.pages?.length||0} صفحة</span></div><div style="font-weight:800;margin-top:4px">${esc(c.title||('الفصل '+c.number))}</div><div class="chapter-meta">${esc(c.published_at||'بدون تاريخ')}</div></div><div class="row"><button class="btn editChapter" data-id="${esc(c.id)}">تعديل</button><button class="btn danger deleteChapter" data-id="${esc(c.id)}">حذف</button></div></div>`}
function renderChapters(){const q=($('chapterSearch')?.value||'').trim().toLowerCase();const sort=$('chapterSort')?.value||'desc';let list=chaptersCache.filter(c=>`${c.number} ${c.title||''}`.toLowerCase().includes(q));list.sort((a,b)=>sort==='desc'?Number(b.number)-Number(a.number):Number(a.number)-Number(b.number));$('chaptersList').innerHTML=list.length?list.map(c=>chapterMarkup(c)).join(''):`<div class="empty">لا توجد نتائج مطابقة.</div>`;bindChapterActions()}
function renderRecent(){const list=chaptersCache.slice(0,5);$('recentChapters').innerHTML=list.length?list.map(c=>chapterMarkup(c,true)).join(''):`<div class="empty">لا توجد فصول منشورة بعد.</div>`;bindChapterActions()}
function bindChapterActions(){document.querySelectorAll('.editChapter').forEach(b=>b.onclick=()=>editChapter(b.dataset.id));document.querySelectorAll('.deleteChapter').forEach(b=>b.onclick=()=>deleteChapter(b.dataset.id))}
function editChapter(id){const c=chaptersCache.find(x=>x.id===id);if(!c)return;$('num').value=c.number;$('title').value=c.title||'';$('date').value=c.published_at||'';$('uploadMode').value='append';selectedFiles=[];renderFiles();setTab('publishTab');toast('تم تحميل بيانات الفصل للتعديل.')}
async function deleteChapter(id){const c=chaptersCache.find(x=>x.id===id);if(!c)return;if(!confirm(`حذف الفصل ${c.number} وكل صفحاته من قاعدة البيانات وStorage؟`))return;try{const pages=await db.from('pages').select('id,storage_path').eq('chapter_id',id);if(pages.error)throw pages.error;const paths=(pages.data||[]).map(x=>x.storage_path).filter(Boolean);if(paths.length){const s=await db.storage.from('manga-pages').remove(paths);if(s.error)throw s.error}const r=await db.from('chapters').delete().eq('id',id);if(r.error)throw r.error;toast('تم حذف الفصل وصفحاته.');refreshAll()}catch(e){toast('فشل حذف الفصل: '+e.message,'err')}}
function fillPageChapter(){const current=$('pageChapter').value;$('pageChapter').innerHTML=chaptersCache.map(c=>`<option value="${esc(c.id)}">الفصل ${esc(c.number)} — ${esc(c.title||'')}</option>`).join('');if(chaptersCache.some(c=>c.id===current))$('pageChapter').value=current;loadPageList()}
$('pageChapter').onchange=loadPageList;
async function loadPageList(){const id=$('pageChapter').value;if(!id){$('pageList').innerHTML='<div class="empty" style="grid-column:1/-1">لا توجد فصول.</div>';return}const r=await db.from('pages').select('id,page_number,storage_path').eq('chapter_id',id).order('page_number',{ascending:true});if(r.error){$('pageList').innerHTML='<div class="empty" style="grid-column:1/-1">خطأ: '+esc(r.error.message)+'</div>';return}$('pageList').innerHTML=r.data?.length?r.data.map(p=>`<div class="page-card"><img src="${esc(publicUrl(p.storage_path))}" alt="صفحة ${esc(p.page_number)}" loading="lazy"><div class="page-foot"><small>صفحة ${esc(p.page_number)}</small><button class="btn danger delPage" data-id="${esc(p.id)}" data-path="${esc(p.storage_path)}">حذف</button></div></div>`).join(''):`<div class="empty" style="grid-column:1/-1">لا توجد صفحات لهذا الفصل.</div>`;document.querySelectorAll('.delPage').forEach(b=>b.onclick=()=>deletePage(b.dataset.id,b.dataset.path))}
async function deletePage(id,path){if(!confirm('حذف هذه الصفحة من قاعدة البيانات وStorage؟'))return;try{const s=await db.storage.from('manga-pages').remove([path]);if(s.error)throw s.error;const r=await db.from('pages').delete().eq('id',id);if(r.error)throw r.error;say('pageMsg','تم حذف الصفحة.');toast('تم حذف الصفحة.');refreshAll()}catch(e){say('pageMsg','فشل حذف الصفحة: '+e.message);toast('فشل حذف الصفحة: '+e.message,'err')}}
$('saveManga').onclick=async()=>{try{const payload={title:$('mTitle').value.trim(),english:$('mEnglish').value.trim(),japanese:$('mJapanese').value.trim(),status:$('mStatus').value.trim(),author:$('mAuthor').value.trim(),artist:$('mArtist').value.trim(),cover_url:$('mCover').value.trim()||fallbackCover,genres:$('mGenres').value.split(/[،,]/).map(x=>x.trim()).filter(Boolean),description:$('mDescription').value.trim()};let r;if(mangaId)r=await db.from('manga').update(payload).eq('id',mangaId);else{const x=await db.from('manga').insert(payload).select('id').single();r=x;if(!x.error)mangaId=x.data.id}if(r.error)throw r.error;say('mangaMsg','تم حفظ معلومات المانجا بنجاح.');$('coverPreview').src=payload.cover_url;toast('تم حفظ بيانات المانجا.');refreshAll()}catch(e){say('mangaMsg','فشل الحفظ: '+e.message);toast('فشل حفظ البيانات: '+e.message,'err')}};
$('mCover').addEventListener('input',()=>{$('coverPreview').src=$('mCover').value.trim()||fallbackCover});$('coverPreview').onerror=()=>{$('coverPreview').src=fallbackCover};
function renderFiles(){const box=$('fileList');if(!selectedFiles.length){box.innerHTML='';return}box.innerHTML=selectedFiles.map((f,i)=>`<div class="file-item"><img src="${URL.createObjectURL(f)}" alt=""><div class="file-info"><b>${esc(String(i+1).padStart(3,'0'))} — ${esc(f.name)}</b><small>${(f.size/1024/1024).toFixed(2)} MB</small></div><button class="btn danger removeFile" data-i="${i}">حذف</button></div>`).join('');document.querySelectorAll('.removeFile').forEach(b=>b.onclick=()=>{selectedFiles.splice(Number(b.dataset.i),1);renderFiles()})}
function addFiles(files){const arr=[...files].filter(f=>/^image\/(jpeg|png|webp)$/.test(f.type));selectedFiles=[...selectedFiles,...arr].sort((a,b)=>numericName(a.name)-numericName(b.name)||a.name.localeCompare(b.name,undefined,{numeric:true}));renderFiles()}
$('chooseFiles').onclick=()=>$('files').click();$('dropzone').onclick=()=>$('files').click();$('files').onchange=e=>addFiles(e.target.files);['dragenter','dragover'].forEach(ev=>$('dropzone').addEventListener(ev,e=>{e.preventDefault();$('dropzone').classList.add('drag')}));['dragleave','drop'].forEach(ev=>$('dropzone').addEventListener(ev,e=>{e.preventDefault();$('dropzone').classList.remove('drag')}));$('dropzone').addEventListener('drop',e=>addFiles(e.dataTransfer.files));$('clearFiles').onclick=()=>{selectedFiles=[];$('files').value='';renderFiles();$('bar').style.width='0%';say('uploadMsg','')};
$('saveChapter').onclick=async()=>{const number=Number($('num').value),title=$('title').value.trim()||('الفصل '+number),date=$('date').value||null;if(!number)return say('uploadMsg','أدخل رقم فصل صحيح.');if(!selectedFiles.length&&$('uploadMode').value==='replace')return say('uploadMsg','وضع الاستبدال يتطلب اختيار صور جديدة.');$('saveChapter').disabled=true;$('bar').style.width='0%';say('uploadMsg','جاري حفظ الفصل...');try{const s=await session();if(!s)throw Error('انتهت جلسة الإدارة. سجّل الدخول مجددًا.');await db.auth.refreshSession();const manga=await getManga();if(!manga)throw Error('لا توجد بيانات مانجا. احفظها أولًا.');let c=await db.from('chapters').select('id').eq('manga_id',manga.id).eq('number',number).maybeSingle();if(c.error)throw c.error;let chapterId;if(c.data){chapterId=c.data.id;const u=await db.from('chapters').update({title,published_at:date}).eq('id',chapterId);if(u.error)throw u.error}else{const n=await db.from('chapters').insert({manga_id:manga.id,number,title,published_at:date}).select('id').single();if(n.error)throw n.error;chapterId=n.data.id}
if($('uploadMode').value==='replace'){const old=await db.from('pages').select('id,storage_path').eq('chapter_id',chapterId);if(old.error)throw old.error;const paths=(old.data||[]).map(x=>x.storage_path).filter(Boolean);if(paths.length){const sr=await db.storage.from('manga-pages').remove(paths);if(sr.error)throw sr.error}const dr=await db.from('pages').delete().eq('chapter_id',chapterId);if(dr.error)throw dr.error}
if(selectedFiles.length){const old=await db.from('pages').select('page_number').eq('chapter_id',chapterId).order('page_number',{ascending:false}).limit(1);if(old.error)throw old.error;let start=(old.data?.[0]?.page_number||0)+1;if($('uploadMode').value==='replace')start=1;for(let i=0;i<selectedFiles.length;i++){const f=selectedFiles[i],ext=(f.name.split('.').pop()||'jpg').toLowerCase().replace(/[^a-z0-9]/g,'')||'jpg',pageNo=start+i,path=`${chapterId}/${String(pageNo).padStart(4,'0')}.${ext}`;say('uploadMsg',`رفع الصفحة ${i+1} من ${selectedFiles.length}...`);const u=await db.storage.from('manga-pages').upload(path,f,{upsert:false,contentType:f.type||'image/jpeg',cacheControl:'31536000'});if(u.error)throw Error(`فشل رفع الصفحة ${i+1}: ${u.error.message}`);const d=await db.from('pages').upsert({chapter_id:chapterId,page_number:pageNo,storage_path:path},{onConflict:'chapter_id,page_number'});if(d.error)throw Error(`تم رفع الصورة لكن فشل تسجيل الصفحة ${pageNo}: ${d.error.message}`);$('bar').style.width=((i+1)/selectedFiles.length*100)+'%'}}
say('uploadMsg',`تم حفظ الفصل ${number} بنجاح.`);toast(`تم حفظ الفصل ${number}.`);selectedFiles=[];$('files').value='';renderFiles();refreshAll()}catch(e){console.error(e);say('uploadMsg','حدث خطأ:\n'+e.message);toast('حدث خطأ: '+e.message,'err')}finally{$('saveChapter').disabled=false}};
$('refreshBtn').onclick=refreshAll;$('refreshChapters').onclick=refreshAll;$('refreshPages').onclick=loadPageList;$('chapterSearch').oninput=renderChapters;$('chapterSort').onchange=renderChapters;
$('date').value=new Date().toISOString().slice(0,10);
(async()=>{try{if(await session())showApp();else showLogin()}catch(e){showLogin(e.message)}})();
</script>
</body>
</html>
